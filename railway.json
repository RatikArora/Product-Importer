{
  "name": "fulfil-product-importer",
  "services": {
    "web": {
      "source": {
        "repo": "https://github.com/RatikArora/Product-Importer"
      },
      "build": {
        "builder": "NIXPACKS"
      },
      "deploy": {
        "startCommand": "uvicorn app.main:app --host 0.0.0.0 --port $PORT",
        "healthcheckPath": "/health",
        "healthcheckTimeout": 100,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 3
      }
    },
    "worker": {
      "source": {
        "repo": "https://github.com/RatikArora/Product-Importer"
      },
      "build": {
        "builder": "NIXPACKS"
      },
      "deploy": {
        "startCommand": "celery -A app.tasks.import_tasks worker --loglevel=info"
      }
    }
  },
  "plugins": {
    "postgresql": {
      "plan": "hobby"
    },
    "redis": {
      "plan": "hobby"
    }
  },
  "variables": {
    "SECRET_KEY": "${{ secrets.SECRET_KEY }}",
    "CHUNK_SIZE": "500",
    "MAX_FILE_SIZE": "104857600"
  }
}